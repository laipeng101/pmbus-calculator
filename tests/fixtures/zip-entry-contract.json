{
  "description": "Path rules shared by the ZIP reader and the Pages staging tree.",
  "legal": ["index.html", "assets/app.js", "assets/file with spaces.js", "资产/页面.js"],
  "illegal": [
    {
      "entry": "",
      "note": "empty entry cannot be represented inside a zip; constructing one must fail"
    },
    { "entry": "/absolute" },
    { "entry": "../escape" },
    { "entry": "a/../escape" },
    { "entry": "./file" },
    { "entry": "a//b" },
    { "entry": "a\\b" },
    { "entry": "a\u0000b" },
    { "entry": "a\u001fb" },
    { "entry": "node_modules/x" },
    { "entry": "src/main.tsx" },
    { "entry": "out.map" },
    { "entry": "C:/escape.txt", "note": "Windows drive absolute (forward slash)" },
    { "entry": "C:\\escape.txt", "note": "Windows drive absolute (backslash)" },
    { "entry": "C:escape.txt", "note": "Windows drive-relative" },
    { "entry": "//server/share/file.txt", "note": "UNC (forward slashes)" },
    { "entry": "\\\\server\\share\\file.txt", "note": "UNC (backslashes)" }
  ]
}
