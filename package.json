{
  "name": "pmbus-calculator",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -b --pretty false --verbose",
    "lint": "eslint .",
    "check:markdown-math": "node scripts/check-markdown-math.mjs",
    "check:inline-style": "node scripts/check-inline-style.mjs",
    "check:no-title-help": "node scripts/check-no-title-help.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run check:inline-style && npm run test:run && npm run build",
    "check:release-contract": "node scripts/check-release-contract.mjs",
    "check:release-docs-commands": "node scripts/check-release-docs-commands.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "doctor": "node scripts/check-toolchain.mjs",
    "release:prepare-assets": "node scripts/prepare-release-assets.mjs",
    "postinstall": "node scripts/install-git-hooks.mjs",
    "verify:ui": "npm run verify && npm run test:e2e:visual",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run check:inline-style && npm run check:no-title-help && npm run check:markdown-math && npm run specs:check && npm run check:release-contract && npm run check:release-docs-commands && npm run check:toolchain && npm run test:coverage && npm run build && npm run check:tailwind-scope && npm run test:e2e && npm run test:e2e:mobile && npm run test:e2e:release && npm run check:repo-hygiene && git diff --check && git diff --cached --check && npm audit --audit-level=high",
    "verify:light": "npm run format:check && npm run check:markdown-math && npm run check:release-docs-commands && npm run check:repo-hygiene && git diff --check && git diff --cached --check",
    "ci:classify": "node scripts/classify-ci-scope.mjs",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:deployment": "playwright test --config playwright.deployment.config.ts",
    "clean": "node scripts/clean-generated.mjs",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:tailwind-scope": "node scripts/check-tailwind-scope.mjs",
    "specs:check": "node scripts/specifications.mjs check",
    "specs:list": "node scripts/specifications.mjs list",
    "specs:fetch": "node scripts/specifications.mjs fetch",
    "specs:verify-cache": "node scripts/specifications.mjs verify-cache"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format:check && npm run typecheck && npm run test:run"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "katex": "0.18.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "22.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
